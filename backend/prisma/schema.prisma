generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          String         @default("CONTRACTOR")
  phone         String?
  companyName   String?
  taskType      String?
  contractorId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedMine  String?
  notifications Notification[]
}

model Contractor {
  id                   String                @id @default(uuid())
  contractorCode       String                @unique
  name                 String
  email                String?
  phone                String?
  taskType             String
  riskLevel            String                @default("LOW")
  violationCount       Int                   @default(0)
  isRestricted         Boolean               @default(false)
  activeWorkers        Int                   @default(0)
  activeMachinery      Int                   @default(0)
  complianceRate       Float                 @default(100.0)
  status               String                @default("PENDING")
  requestedMine        String?
  assignedMine         String?
  rejectionReason      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  AuditLog             AuditLog[]
  dailyLogs            DailyLog[]
  explosivesStock      ExplosivesStock[]
  inspections          Inspection[]
  licenses             License[]
  machinery            Machinery[]
  Notification         Notification[]
  observations         Observation[]
  statutoryObligations StatutoryObligation[]
  workers              Worker[]
}

model Observation {
  id               String      @id @default(uuid())
  observationCode  String      @unique
  contractorId     String
  supervisorName   String
  supervisorId     String?
  zone             String
  category         String
  severity         String
  description      String
  photoUrl         String?
  gpsCoordinates   String?
  status           String      @default("OPEN")
  evidenceUrl      String?
  evidenceNotes    String?
  correctiveAction String?
  submittedAt      DateTime?
  resolvedAt       DateTime?
  resolutionNotes  String?
  verifiedBy       String?
  inspectionId     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  auditLogs        AuditLog[]
  inspection       Inspection? @relation(fields: [inspectionId], references: [id])
  contractor       Contractor  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model Inspection {
  id               String        @id @default(uuid())
  clientRefId      String?       @unique
  mineId           String?
  zone             String?
  inspectorId      String
  contractorId     String?
  taskType         String?
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  status           String        @default("SUBMITTED")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contractor       Contractor?   @relation(fields: [contractorId], references: [id])
  observations     Observation[]
}

model License {
  id             String     @id @default(uuid())
  contractorId   String
  documentType   String
  documentNumber String
  holder         String
  expiryDate     DateTime
  status         String     @default("VALID")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model Machinery {
  id           String     @id @default(uuid())
  contractorId String
  machineName  String
  ownership    String
  lastServiced DateTime?
  nextDue      DateTime?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model Worker {
  id             String     @id @default(uuid())
  contractorId   String
  workerCode     String
  fullName       String?
  role           String?
  trainingStatus String     @default("COMPLETE")
  ppeIssued      Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model ExplosivesStock {
  id            String     @id @default(uuid())
  contractorId  String
  explosiveType String
  procured      Float
  used          Float
  remaining     Float
  unit          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id           String     @id @default(uuid())
  contractorId String
  logText      String
  zone         String?
  loggedBy     String
  timestamp    DateTime   @default(now())
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model EnvironmentalLog {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  dailyTonnage Float
  pm10Dust     Float
  effluentPh   Float
  noiseDb      Float
  riskScore    Float
  riskLabel    String
  loggedBy     String
  notes        String?
  createdAt    DateTime @default(now())

  environmentalReportId String? @unique
  environmentalReport   EnvironmentalReport? @relation(fields: [environmentalReportId], references: [id])
}

model EnvironmentalReport {
  id              String   @id @default(uuid())
  documentType    String
  reportId        String?
  facilityName    String?
  location        String?
  samplingDate    DateTime?
  provider        String?
  uploadedBy      String
  status          String   @default("PENDING_REVIEW")
  documentUrl     String
  extractedData   String
  documentHash    String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  environmentalLog EnvironmentalLog?
}

model StatutoryObligation {
  id               String       @id @default(uuid())
  title            String
  description      String
  domain           String
  contractorId     String?
  taskType         String?
  zone             String?
  frequency        String
  dueDate          DateTime?
  nextDueDate      DateTime?
  status           String       @default("PENDING")
  evidenceRequired Boolean      @default(true)
  evidenceUrl      String?
  evidenceNotes    String?
  lastCompletedAt  DateTime?
  verifiedBy       String?
  verifiedAt       DateTime?
  notes            String?
  sourceReference  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  auditLogs        AuditLog[]
  escalations      Escalation[]
  contractor       Contractor?  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String               @id @default(uuid())
  observationId String?
  obligationId  String?
  contractorId  String?
  action        String
  actorRole     String
  actorName     String
  details       String
  timestamp     DateTime             @default(now())
  Contractor    Contractor?          @relation(fields: [contractorId], references: [id])
  obligation    StatutoryObligation? @relation(fields: [obligationId], references: [id])
  observation   Observation?         @relation(fields: [observationId], references: [id])
}

model Escalation {
  id           String              @id @default(uuid())
  obligationId String
  level        String
  reason       String
  triggeredBy  String
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime            @default(now())
  obligation   StatutoryObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
}

model Notification {
  id           String      @id @default(uuid())
  recipientId  String
  type         String
  title        String
  message      String
  isRead       Boolean     @default(false)
  resourceType String?
  resourceId   String?
  contractorId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  Contractor   Contractor? @relation(fields: [contractorId], references: [id])
  recipient    User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}
