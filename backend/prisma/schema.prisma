generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("CONTRACTOR") // CONTRACTOR, SUPERVISOR
  phone        String?
  companyName  String?
  taskType     String? // blasting, transportation, excavation, maintenance
  contractorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contractor {
  id              String   @id @default(uuid())
  contractorCode  String   @unique
  name            String
  email           String?
  phone           String?
  taskType        String // blasting, transportation, excavation, maintenance
  riskLevel       String   @default("LOW") // LOW, MODERATE, HIGH, CRITICAL
  violationCount  Int      @default(0)
  isRestricted    Boolean  @default(false)
  activeWorkers   Int      @default(0)
  activeMachinery Int      @default(0)
  complianceRate  Float    @default(100.0)
  status          String   @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  observations         Observation[]
  licenses             License[]
  machinery            Machinery[]
  workers              Worker[]
  explosivesStock      ExplosivesStock[]
  dailyLogs            DailyLog[]
  statutoryObligations StatutoryObligation[]
  inspections          Inspection[]
}

model Observation {
  id               String      @id @default(uuid())
  observationCode  String      @unique
  contractorId     String
  contractor       Contractor  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  supervisorName   String
  zone             String // e.g. "Pit A", "Haul Road 2", "Zone B"
  category         String // PPE, DUST, EFFLUENT, EQUIPMENT, BLASTING, OTHER
  severity         String // LOW, MODERATE, CRITICAL
  description      String
  photoUrl         String?
  gpsCoordinates   String?
  status           String      @default("OPEN") // OPEN, ACTION_SUBMITTED, EVIDENCE_SUBMITTED, RESOLVED
  evidenceUrl      String?
  evidenceNotes    String?
  correctiveAction String?
  submittedAt      DateTime?
  resolvedAt       DateTime?
  resolutionNotes  String?
  verifiedBy       String?
  inspectionId     String?
  inspection       Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  auditLogs AuditLog[]
}

model Inspection {
  id               String      @id @default(uuid())
  clientRefId      String?     @unique // For offline idempotency
  mineId           String?
  zone             String?
  inspectorId      String
  contractorId     String?
  contractor       Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  taskType         String?
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  startedAt        DateTime    @default(now())
  submittedAt      DateTime?
  status           String      @default("SUBMITTED") // DRAFT, SUBMITTED
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  observations Observation[]
}

model License {
  id             String     @id @default(uuid())
  contractorId   String
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  documentType   String // Contract Labour License, Blaster's Certificate (DGMS), Explosives License
  documentNumber String
  holder         String
  expiryDate     DateTime
  status         String     @default("VALID") // VALID, EXPIRING_SOON, EXPIRED
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Machinery {
  id           String     @id @default(uuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  machineName  String
  ownership    String // OWNED, RENTED, FINANCED
  lastServiced DateTime?
  nextDue      DateTime?
  status       String     @default("ACTIVE") // ACTIVE, DUE_SOON, OVERDUE, UNDER_MAINTENANCE
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Worker {
  id             String     @id @default(uuid())
  contractorId   String
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workerCode     String
  fullName       String?
  role           String?
  trainingStatus String     @default("COMPLETE") // COMPLETE, MISSING
  ppeIssued      Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ExplosivesStock {
  id            String     @id @default(uuid())
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  explosiveType String // Site-mix emulsion, Detonators
  procured      Float
  used          Float
  remaining     Float
  unit          String // kg, units
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model DailyLog {
  id           String     @id @default(uuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  logText      String
  zone         String?
  loggedBy     String
  timestamp    DateTime   @default(now())
}

model EnvironmentalLog {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  dailyTonnage Float
  pm10Dust     Float // µg/m³
  effluentPh   Float // pH
  noiseDb      Float // dB
  riskScore    Float // Deterministic 0 - 100%
  riskLabel    String // Low, Moderate, Critical
  loggedBy     String
  notes        String?
  createdAt    DateTime @default(now())
}

model StatutoryObligation {
  id               String      @id @default(uuid())
  title            String
  description      String
  domain           String // SAFETY, ENVIRONMENT, PRODUCTION, LABOUR
  contractorId     String?
  contractor       Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  taskType         String? // Applicability based on task type
  zone             String? // Applicability based on zone
  frequency        String // ONCE, DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUAL, EVENT
  dueDate          DateTime?
  nextDueDate      DateTime?
  status           String      @default("PENDING") // COMPLIANT, DUE_SOON, OVERDUE, NON_COMPLIANT, PENDING_VERIFICATION, NOT_APPLICABLE
  evidenceRequired Boolean     @default(true)
  evidenceUrl      String?
  evidenceNotes    String?
  lastCompletedAt  DateTime?
  verifiedBy       String?
  verifiedAt       DateTime?
  notes            String?
  sourceReference  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  auditLogs   AuditLog[]
  escalations Escalation[]
}

model AuditLog {
  id            String               @id @default(uuid())
  observationId String?
  observation   Observation?         @relation(fields: [observationId], references: [id], onDelete: SetNull)
  obligationId  String?
  obligation    StatutoryObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  action        String // CREATED, EVIDENCE_SUBMITTED, VERIFIED_APPROVED, REJECTED, ESCALATED, STATUS_CHANGED
  actorRole     String // SUPERVISOR, CONTRACTOR, SYSTEM
  actorName     String
  details       String
  timestamp     DateTime             @default(now())
}

// Escalation chain: Contractor → Supervisor → Management
// Each record is append-only and immutable (no update route exposed).
model Escalation {
  id           String              @id @default(uuid())
  obligationId String
  obligation   StatutoryObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  level        String // SUPERVISOR, MANAGEMENT, CORPORATE (future)
  reason       String
  triggeredBy  String // email or name of the supervisor who escalated
  resolvedAt   DateTime? // set when escalation is closed
  resolution   String? // resolution notes
  createdAt    DateTime            @default(now())
}
